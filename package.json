{
  "name": "interactive-cmyk-moire",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first interactive CMYK moiré generative art canvas built with React, TypeScript, WebGL2, GLSL ES 3.00, Tailwind CSS, and IndexedDB.",
  "type": "module",
  "scripts": {
    "dev": "vite",
